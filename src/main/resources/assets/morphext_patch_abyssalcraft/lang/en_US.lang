item.morphext_patch_abyssalcraft.cursed_milk.desc=Clears potion effects, but the abyssal void afflicts the drinker with nausea and weakness...
item.morphext_patch_abyssalcraft.demon_wool.name=Demon Wool
item.morphext_patch_abyssalcraft.anti_egg.name=Antimatter Void Egg
